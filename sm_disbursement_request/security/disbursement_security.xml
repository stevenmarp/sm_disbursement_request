<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_sm_disbursement" model="ir.module.category">
            <field name="name">Disbursement Request</field>
            <field name="sequence">85</field>
        </record>

        <record id="res_groups_privilege_sm_disbursement" model="res.groups.privilege">
            <field name="name">Disbursement Request</field>
            <field name="category_id" ref="module_category_sm_disbursement"/>
            <field name="sequence">85</field>
        </record>

        <record id="group_sm_disbursement_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_sm_disbursement"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sm_disbursement_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_sm_disbursement"/>
            <field name="implied_ids" eval="[(4, ref('group_sm_disbursement_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
